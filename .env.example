# Base de datos (Neon / Supabase / Postgres local)
DATABASE_URL=postgresql://user:pass@localhost:5432/senaliza
PAYLOAD_SECRET=cambia-esto-por-un-texto-largo-aleatorio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (imágenes). Si R2_BUCKET está vacío, se guardan en disco local (solo desarrollo).
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://cdn.tudominio.cl

# Tienda
NEXT_PUBLIC_SITE_NAME=Señaliza
NEXT_PUBLIC_WHATSAPP=56900000000
NEXT_PUBLIC_CONTACT_EMAIL=ventas@tudominio.cl
# Datos de transferencia que se muestran al confirmar el pedido (separa las líneas con \n)
BANK_DETAILS=Banco: ...\nTipo de cuenta: ...\nN° de cuenta: ...\nNombre: ...\nRUT: ...\nEmail: ...

# Getnet (Santander) - Web Checkout. Ambiente: test (pruebas, sin dinero real) o production.
# Las credenciales de PRUEBA vienen en el manual de integración (Web Checkout, sección "Ambientes disponibles").
# Las de producción las entrega Getnet cuando valida tu integración. Son secretas: nunca en GitHub.
GETNET_ENV=test
GETNET_LOGIN=
GETNET_SECRET_KEY=
